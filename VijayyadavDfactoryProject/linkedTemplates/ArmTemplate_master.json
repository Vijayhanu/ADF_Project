{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "VijayyadavDfactoryProject"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSql'"
		},
		"ls_onprem_files_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onprem_files'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfvijaystorage.dfs.core.windows.net/"
		},
		"AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adfprojectviji.database.windows.net"
		},
		"AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adfprojectviji"
		},
		"AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adfproject"
		},
		"ls_github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"ls_onprem_files_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\ADF-Project-Source"
		},
		"ls_onprem_files_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "vijaykrishna5@outlook.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "VijayyadavDfactoryProject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureSql_password": {
						"value": "[parameters('AzureSql_password')]"
					},
					"ls_onprem_files_password": {
						"value": "[parameters('ls_onprem_files_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureSql_properties_typeProperties_server": {
						"value": "[parameters('AzureSql_properties_typeProperties_server')]"
					},
					"AzureSql_properties_typeProperties_database": {
						"value": "[parameters('AzureSql_properties_typeProperties_database')]"
					},
					"AzureSql_properties_typeProperties_userName": {
						"value": "[parameters('AzureSql_properties_typeProperties_userName')]"
					},
					"ls_github_properties_typeProperties_url": {
						"value": "[parameters('ls_github_properties_typeProperties_url')]"
					},
					"ls_onprem_files_properties_typeProperties_host": {
						"value": "[parameters('ls_onprem_files_properties_typeProperties_host')]"
					},
					"ls_onprem_files_properties_typeProperties_userId": {
						"value": "[parameters('ls_onprem_files_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "VijayyadavDfactoryProject_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'VijayyadavDfactoryProject_ArmTemplate_0')]"
			]
		}
	]
}