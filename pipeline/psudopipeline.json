					}
				],
				"outputs": [
					{
						"referenceName": "ds_onprem_file",
						"type": "DatasetReference",
						"parameters": {
							"p_filename": "DimFlight.csv"
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-17T13:02:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
